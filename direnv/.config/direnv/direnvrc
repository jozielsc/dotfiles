
layout_uv() {
    if [ -d ".venv" ]; then 
      export VIRTUAL_ENV="$PWD/.venv"
      PATH_add = "$VIRTUAL_ENV/bin"
    fi
}

layout_claude() {
    local account="${1:?uso: layout_claude <conta>}"
    local config_dir="$HOME/.claude-accounts/$account"

    if [[ ! -d "$config_dir" ]]; then
        log_status "conta '$account' não encontrada; criando diretório em $config_dir"
        mkdir -p "$config_dir"
    fi

    log_status "usando a conta $account"

    export CLAUDE_ACCOUNT="$account"
    export CLAUDE_CONFIG_DIR="$config_dir"
}
