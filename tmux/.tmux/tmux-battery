#!/usr/bin/env sh

# Localiza o arquivo de capacidade da bateria
bat_cap=$(ls /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n 1)

# Se não encontrar bateria (ex: PC Desktop), sai sem imprimir nada
[ -z "$bat_cap" ] || [ ! -f "$bat_cap" ] && exit 0

bat_dir=$(dirname "$bat_cap")
cap=$(cat "$bat_cap")
stat=$(cat "$bat_dir/status" 2>/dev/null)

case "$stat" in
"Charging")
  echo " ${cap}%"
  ;;
"Full" | "Not charging")
  echo "🔌 ${cap}%"
  ;;
*)
  echo "🔋 ${cap}%"
  ;;
esac
